@page
@model RazorPagesMovie.Pages.Gallery.IndexModel
@{
    ViewData["Title"] = "Art Gallery";
}
<h1>@ViewData["Title"]</h1>

<p>Welcome to our online art exhibition space.</p>

<div class="row mt-4">
    <div class="col-md-6 mb-3">
        <div class="border p-3">
            <h3>Artwork #1</h3>
            <p><strong>Title:</strong> Sunset Mountains</p>
            <p><strong>Artist:</strong> J. Smith</p>
            <p><strong>Year:</strong> 2024</p>
            <p>Beautiful mountain landscape painting.</p>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="border p-3">
            <h3>Artwork #2</h3>
            <p><strong>Title:</strong> Urban Scene</p>
            <p><strong>Artist:</strong> M. Chen</p>
            <p><strong>Year:</strong> 2023</p>
            <p>Modern city architecture study.</p>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <div class="border p-3">
            <h3>Artwork #3</h3>
            <p><strong>Title:</strong> Ocean Waves</p>
            <p><strong>Artist:</strong> E. Rodriguez</p>
            <p><strong>Year:</strong> 2024</p>
            <p>Abstract water representation.</p>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="border p-3">
            <h3>Artwork #4</h3>
            <p><strong>Title:</strong> Spring Garden</p>
            <p><strong>Artist:</strong> S. Williams</p>
            <p><strong>Year:</strong> 2023</p>
            <p>Floral composition in pastels.</p>
        </div>
    </div>
</div>

<hr />
<p><em>Gallery hours: Mon-Sun 10am-6pm</em></p>
